---
import { pwaInfo } from 'virtual:pwa-info';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import TabBar from '../components/TabBar.astro';
import Icono from '../components/Icono.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // ?simular=AAAA-MM-DD activa el modo simulación; ?simular=no lo quita.
      (function () {
        try {
          var v = new URLSearchParams(location.search).get('simular');
          if (v === null) return;
          if (/^\d{4}-\d{2}-\d{2}$/.test(v)) localStorage.setItem('harada:hoySimulado', v);
          else localStorage.removeItem('harada:hoySimulado');
          history.replaceState(null, '', location.pathname + location.hash);
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1b1d24" />
    <meta name="description" content="Tu cuadrícula Harada de un vistazo: qué toca hoy, qué está hecho y qué pilar va flojo." />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Harada" />
    <title>{title} · Harada</title>
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <script src="../pwa.ts"></script>
  </head>
  <body class="min-h-dvh">
    <div id="simulacion" hidden class="flex items-center justify-between gap-3 bg-acento px-4 pt-[calc(env(safe-area-inset-top)+0.4rem)] pb-1.5 text-xs font-semibold text-bg">
      <span id="simulacion-texto"></span>
      <a href="?simular=no" class="underline">Salir</a>
    </div>
    <script is:inline>
      (function () {
        try {
          var v = localStorage.getItem('harada:hoySimulado');
          if (!v) return;
          var p = v.split('-');
          document.getElementById('simulacion-texto').textContent = 'Simulación: hoy es ' + p[2] + '/' + p[1] + '/' + p[0];
          document.getElementById('simulacion').hidden = false;
        } catch (e) {}
      })();
    </script>
    <header class="sticky top-0 z-10 flex items-center justify-between bg-bg/90 px-5 pt-[calc(env(safe-area-inset-top)+0.75rem)] pb-3 backdrop-blur">
      <h1 class="text-2xl font-bold tracking-tight">{title}</h1>
      <a href="/ajustes" class="-m-2 p-2 text-mut" aria-label="Ajustes">
        <Icono nombre="ajustes" />
      </a>
    </header>
    <main class="mx-auto max-w-md px-4 pb-28 pt-3">
      <slot />
    </main>
    <TabBar />
  </body>
</html>
