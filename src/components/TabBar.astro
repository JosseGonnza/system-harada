---
import Icono from './Icono.astro';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const tabs = [
  { href: '/', label: 'Hoy', icono: 'hoy' },
  { href: '/cuadricula', label: 'Cuadrícula', icono: 'cuadricula' },
  { href: '/semana', label: 'Semana', icono: 'semana' },
] as const;
---

<nav class="fixed inset-x-0 bottom-0 z-10 border-t border-line bg-bg/95 pb-[env(safe-area-inset-bottom)] backdrop-blur">
  <div class="mx-auto grid max-w-md grid-cols-3">
    {
      tabs.map((t) => {
        const on = t.href === path;
        return (
          <a
            href={t.href}
            aria-current={on ? 'page' : undefined}
            class={`flex flex-col items-center gap-1 py-2.5 text-xs font-semibold ${on ? 'text-acento' : 'text-mut'}`}
          >
            <Icono nombre={t.icono} />
            {t.label}
          </a>
        );
      })
    }
  </div>
</nav>
